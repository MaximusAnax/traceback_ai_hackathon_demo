# Supabase (required for demo)
SUPABASE_URL=
SUPABASE_ANON_KEY=

# Anthropic — single LLM for the demo brain (without it the worker uses a static fallback patch)
ANTHROPIC_API_KEY=
# Optional: defaults to claude-sonnet-4-20250514
# ANTHROPIC_MODEL=

# Optional: if set, the sentry-hook-signature header must equal this value (literal compare, not HMAC)
SENTRY_WEBHOOK_SECRET=

# Optional: repo URL shown in the mock sandbox clone output
# DEMO_REPO_URL=https://github.com/demo/traceback-ai
